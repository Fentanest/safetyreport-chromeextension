{
  "manifest_version": 3,
  "name": "나만의 안전신문고",
  "version": "1.2.2",
  "description": "개인 safetyreport 서버 또는 클라우드에서 내 신고 조회",
  "permissions": [
    "storage",
    "identity",
    "clipboardWrite",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "build/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://www.safetyreport.go.kr/*",
        "https://www.safetyreport.go.kr/*"
      ],
      "js": [
        "shared-ui.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui-tokens.css",
        "ui-components.css"
      ],
      "matches": [
        "http://www.safetyreport.go.kr/*",
        "https://www.safetyreport.go.kr/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
